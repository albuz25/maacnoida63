SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Rootle / Aptrack integration. Use production after Rootle/Aptech enables live integration.
APTRACK_ENV=production
APTRACK_AUTH_KEY=your-aptrack-auth-key
APTRACK_USERNAME=SUPER_LEAP
APTRACK_CENTRE_SAP_CODE=your-centre-sap-code

# Optional: comma-separated codes for the chat widget if you need multiple centres.
ROOTLE_SAP_CODES=your-centre-sap-code

# Optional: use this if Aptrack course names do not match the website labels.
# Example: {"3D Animation":445,"VFX & ADVFX":652}
APTRACK_COURSE_MAP_JSON={}
